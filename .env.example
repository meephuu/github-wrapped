# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in what you need. Everything is optional.
# ---------------------------------------------------------------------------

# Server token for PUBLIC pages (/u/<username>). Without it the app uses the public API
# (last 90 days only, 60 requests/hour). Create a classic token with NO scopes ticked:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# "Sign in with GitHub" (shows private activity on /me). Create an OAuth App:
# https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string, used to encrypt the sign-in cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Your deployed URL (used for link-preview images). Leave as is for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
